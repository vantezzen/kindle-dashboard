# ── Google Calendar ───────────────────────────────────────────────────────────
# Obtain credentials from Google Cloud Console (see README for setup steps)
# Run `bun scripts/get-google-token.mjs` to get your GOOGLE_REFRESH_TOKEN

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Comma-separated list of Google Calendar IDs to display (default: "primary")
# Find your calendar IDs at calendar.google.com → Settings → [calendar name] → Calendar ID
# GOOGLE_CALENDAR_IDS=primary,work@example.com

NEXT_PUBLIC_TIMEZONE=Europe/Berlin

# Kindle Connection
KINDLE_IP="192.168.178.54"
KINDLE_PASSWORD="" # optional: set if your Kindle has a root password
